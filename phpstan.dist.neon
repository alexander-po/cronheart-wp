parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        # The stub file lives in `tests/stubs/` but is consumed via
        # `scanFiles` below — analysing its function bodies (intentional
        # no-ops) would report unused-parameter errors that have no
        # bearing on the runtime behaviour we care about.
        - tests/stubs/wordpress.php
    # WordPress core symbols this plugin touches (`add_action`,
    # `wp_schedule_event`, `apply_filters`, …) are not on the
    # classpath at static-analysis time. The stub file declares just
    # the handful we reach for; it is never included at runtime
    # because the test bootstrap requires only `vendor/autoload.php`.
    scanFiles:
        - tests/stubs/wordpress.php
    treatPhpDocTypesAsCertain: false
