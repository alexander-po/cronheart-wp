<?xml version="1.0"?>
<ruleset name="cronheart-wp">
    <description>
        WordPress Coding Standards for the user-facing surface of the
        cronheart-wp plugin: the entry point `cronheart.php` and the
        admin layer under `src/Admin/` that interacts directly with
        WordPress's procedural API (Settings API, admin-AJAX).

        Two scopes, deliberately. The full WordPress rule set
        (`WordPress-Core` + `WordPress-Extra` — tabs, snake_case names,
        Yoda comparisons, etc.) applies ONLY to `cronheart.php`, which is
        hand-written in WP style. The `src/Admin/` classes are PSR-12 +
        strict_types (php-cs-fixer owns their layout, see
        `.php-cs-fixer.dist.php`); dual-enforcing both rule sets on them
        produces unfixable noise. So for the admin layer we run only the
        sniffs that actually matter for a wp_ajax / Settings-API surface —
        output escaping, nonce verification, input sanitisation, and the
        text domain — which were previously not run at all (the admin files
        were outside phpcs scope), making "phpcs clean" vacuous there.
    </description>

    <file>cronheart.php</file>
    <file>src/Admin/</file>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="ps"/>

    <!-- Full WP coding standards: WP-style entry point only. -->
    <rule ref="WordPress-Core">
        <include-pattern>*/cronheart.php</include-pattern>
    </rule>
    <rule ref="WordPress-Extra">
        <include-pattern>*/cronheart.php</include-pattern>
    </rule>

    <!-- Security + i18n sniffs: run on BOTH the WP-style entry point AND the
         admin / AJAX layer — escape every echo, verify a nonce before
         touching request input, sanitise that input at the boundary, and use
         the plugin text domain. These checks are inherited from
         WordPress-Core/Extra above, whose `*/cronheart.php` include-pattern
         would otherwise confine them to the entry point (PHPCS merges
         include-patterns per sniff, so a bare re-reference does NOT widen the
         scope). The explicit `src/Admin` pattern on each is what makes them
         actually run on the wp_ajax / Settings-API surface they matter for —
         without it, "phpcs clean" would be vacuous there. -->
    <rule ref="WordPress.Security.EscapeOutput">
        <include-pattern>*/cronheart.php</include-pattern>
        <include-pattern>*/src/Admin/*</include-pattern>
    </rule>
    <rule ref="WordPress.Security.NonceVerification">
        <include-pattern>*/cronheart.php</include-pattern>
        <include-pattern>*/src/Admin/*</include-pattern>
    </rule>
    <rule ref="WordPress.Security.ValidatedSanitizedInput">
        <include-pattern>*/cronheart.php</include-pattern>
        <include-pattern>*/src/Admin/*</include-pattern>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <include-pattern>*/cronheart.php</include-pattern>
        <include-pattern>*/src/Admin/*</include-pattern>
        <properties>
            <property name="text_domain" type="array">
                <element value="cronheart"/>
            </property>
        </properties>
    </rule>

    <!-- Global namespace pollution check. Every function, constant,
         class, and hook this plugin contributes to the global
         namespace must start with one of these prefixes. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="cronheart"/>
                <element value="Cronheart\WP"/>
            </property>
        </properties>
    </rule>

    <!-- Minimum supported WordPress and PHP versions for the
         deprecation / compatibility sniffs. -->
    <config name="minimum_supported_wp_version" value="6.0"/>
    <config name="testVersion" value="8.2-"/>
</ruleset>
